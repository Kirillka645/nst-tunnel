<?xml version="1.0" encoding="utf-8"?>
<!--
    Edge-to-edge ready main layout.

    DrawerLayout is the window root: no `fitsSystemWindows="true"` because
    MainActivity.applyEdgeToEdgeInsets() dispatches window insets to the
    children that actually need them (Toolbar, FAB, NavigationView, bottom panel).

    Background uses `?attr/colorSurface` so the screen blends with the splash
    and system bars — no flash of black on launch.

    Keeps the quick-actions panel introduced in 2.1.6 (Test All Profiles +
    Paste from Clipboard) but restyled with Material-3 attribute colours so
    light/dark and dynamic palettes pick up automatically.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
            AppBar with M3 lift-on-scroll: gains elevation tint as content scrolls
            under it, replacing the old hardcoded shadow.
        -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:liftOnScroll="true"
            app:liftOnScrollColor="?attr/colorSurfaceContainer">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:titleTextAppearance="?attr/textAppearanceTitleLarge"
                app:titleTextColor="?attr/colorOnSurface" />

        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Indeterminate progress lives directly under the toolbar; recolours via theme. -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="invisible"
                        app:indicatorColor="?attr/colorSecondary"
                        app:trackColor="?attr/colorSurfaceContainerHigh" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/colorSurface"
                        app:tabIndicatorAnimationMode="elastic"
                        app:tabIndicatorColor="?attr/colorSecondary"
                        app:tabIndicatorFullWidth="false"
                        app:tabMode="scrollable"
                        app:tabRippleColor="?attr/colorSurfaceContainerHigh"
                        app:tabSelectedTextColor="?attr/colorSecondary"
                        app:tabTextAppearance="@style/TabLayoutTextStyle"
                        app:tabTextColor="?attr/colorOnSurfaceVariant" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/view_pager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="?attr/colorSurface"
                        android:nextFocusRight="@+id/fab"
                        android:scrollbars="vertical" />

                    <!--
                        Bottom action strip — status line on top, quick-action buttons beneath.
                        The activity adds a bottom system-bar inset as padding, keeping
                        everything visible above the gesture-navigation pill.
                    -->
                    <LinearLayout
                        android:id="@+id/layout_bottom_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_spacing_dp8"
                        android:layout_marginTop="@dimen/padding_spacing_dp8"
                        android:layout_marginEnd="@dimen/padding_spacing_dp8"
                        android:layout_marginBottom="@dimen/padding_spacing_dp8"
                        android:background="?attr/colorSurfaceContainerLow"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_spacing_dp8">

                        <!-- Test / latency / state row. -->
                        <LinearLayout
                            android:id="@+id/layout_test"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/view_height_dp48"
                            android:background="?attr/colorSurfaceContainer"
                            android:clickable="true"
                            android:contentDescription="@string/connection_test_pending"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/view_pager"
                            android:nextFocusRight="@+id/fab"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/padding_spacing_dp16"
                            android:paddingEnd="@dimen/padding_spacing_dp16">

                            <TextView
                                android:id="@+id/tv_test_state"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="start|center_vertical"
                                android:maxLines="2"
                                android:minLines="1"
                                android:text="@string/connection_test_pending"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <!-- Quick-actions row (introduced in 2.1.6). -->
                        <LinearLayout
                            android:id="@+id/layout_quick_actions"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/view_height_dp48"
                            android:layout_marginTop="@dimen/padding_spacing_dp8"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_test_all_profiles"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="@dimen/padding_spacing_dp4"
                                android:layout_weight="1"
                                android:contentDescription="@string/action_check_all_profiles"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/action_check_all_profiles"
                                android:textColor="?attr/colorOnSecondary"
                                app:backgroundTint="?attr/colorSecondary"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_select_all_24dp"
                                app:iconGravity="textStart"
                                app:iconPadding="@dimen/padding_spacing_dp8"
                                app:iconTint="?attr/colorOnSecondary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_import_clipboard"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/padding_spacing_dp4"
                                android:layout_weight="1"
                                android:contentDescription="@string/action_paste_from_clipboard"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/action_paste_from_clipboard"
                                android:textColor="?attr/colorOnSurface"
                                app:backgroundTint="?attr/colorSurfaceContainerHigh"
                                app:cornerRadius="16dp"
                                app:icon="@drawable/ic_content_paste_24dp"
                                app:iconGravity="textStart"
                                app:iconPadding="@dimen/padding_spacing_dp8"
                                app:iconTint="?attr/colorOnSurface"
                                app:strokeColor="?attr/colorOutlineVariant"
                                app:strokeWidth="1dp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!--
                    FAB anchored above the bottom panel. Large bottom margin (136 dp)
                    clears the status-row + quick-actions combo; MainActivity adds the
                    system-bar inset on top so gesture navigation doesn't cover it.
                -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/padding_spacing_dp16"
                    android:layout_marginBottom="136dp"
                    android:clickable="true"
                    android:contentDescription="@string/tasker_start_service"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/layout_test"
                    android:src="@drawable/ic_play_24dp"
                    app:backgroundTint="@color/color_fab_inactive"
                    app:tint="?attr/colorOnSecondary"
                    app:useCompatPadding="true"
                    tools:ignore="ContentDescription" />

            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </RelativeLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurfaceContainer"
        android:fitsSystemWindows="false"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
