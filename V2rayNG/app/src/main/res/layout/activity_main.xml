<?xml version="1.0" encoding="utf-8"?>
<!--
  Stable structure from v2.23 (BlueStacks-safe):
  Drawer + CoordinatorLayout + real FAB + LinearProgressIndicator.
  Visual layer only: gradient, bottom-center circular connect, cards-friendly chrome.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_gradient"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent" />

        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="invisible"
                        app:indicatorColor="@color/color_fab_active"
                        app:trackColor="@android:color/transparent" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        app:tabIndicatorColor="@color/md_theme_secondary"
                        app:tabIndicatorFullWidth="false"
                        app:tabMode="scrollable"
                        app:tabSelectedTextColor="@color/colorWhite"
                        app:tabTextAppearance="@style/TabLayoutTextStyle"
                        app:tabTextColor="@color/happ_tab_unselected" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/view_pager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:nextFocusRight="@+id/fab"
                        android:paddingBottom="88dp"
                        android:scrollbars="vertical" />

                    <!-- Status strip (Happ-like footer) -->
                    <LinearLayout
                        android:id="@+id/layout_test"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_bar"
                        android:clickable="true"
                        android:contentDescription="@string/connection_test_pending"
                        android:focusable="true"
                        android:minHeight="64dp"
                        android:nextFocusLeft="@+id/view_pager"
                        android:nextFocusRight="@+id/fab"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/connection_test_hint"
                                android:textColor="@color/happ_tab_unselected"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_test_state"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="2"
                                android:minLines="1"
                                android:text="@string/connection_test_pending"
                                android:textColor="@color/happ_muted_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_ping"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_vertical"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_ping_servers"
                            android:padding="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_speed_24dp"
                            app:tint="@color/md_theme_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Connect control: bottom-center, real FAB, modest size (not 150dp hero) -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="52dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/connect_glow_outer" />

                    <View
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center"
                        android:background="@drawable/connect_glow_inner" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="@string/tasker_start_service"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/layout_test"
                        android:src="@drawable/ic_power_24dp"
                        app:backgroundTint="@color/color_fab_inactive"
                        app:borderWidth="0dp"
                        app:elevation="10dp"
                        app:fabCustomSize="68dp"
                        app:maxImageSize="32dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.NST.FabCircle"
                        app:tint="@color/colorWhite"
                        app:useCompatPadding="false" />
                </FrameLayout>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </RelativeLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/md_theme_surface"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/happ_muted_text"
        app:itemTextColor="@color/happ_muted_text"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
